# Obrigatórias: sem elas o servidor não sobe (validadas em src/config/env.ts)
DATABASE_URL=""
OPENAI_API_KEY=""
JWT_SECRET=""
# Formato do jsonwebtoken com unidade, ex.: "7d", "12h" (sem unidade = milissegundos)
JWT_EXPIRES_IN=""

# Exigida pelo Prisma CLI (build e migrations). No Supabase use o SESSION POOLER, igual ao DATABASE_URL
# mas sem "?pgbouncer=true" (porta 5432): o host direto db.<ref>.supabase.co só tem IPv6 e a Railway não alcança.
DATABASE_DIRECT_URL=""

# Opcionais
PORT = 3065
PRISMA_DISABLE_PREPARED_STATEMENTS=true
# Em produção (Railway) defina NODE_ENV=production: esconde o /api-docs
NODE_ENV=development
# true expõe o /api-docs mesmo com NODE_ENV=production
API_DOCS_ENABLED=false
