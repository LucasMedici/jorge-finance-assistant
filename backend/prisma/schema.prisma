// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider  = "prisma-client"
  output    = "../src/generated/prisma"
  dataProxy = false
}

datasource db {
  provider     = "postgresql"
  schemas      = ["public", "assistent"]
  url          = env("DATABASE_URL")
  directUrl    = env("DATABASE_DIRECT_URL")
  relationMode = "prisma"
}

model transaction {
  id          String   @id @default(uuid())
  phone       String
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  category    String?
  description String?
  messageId   String?
  createdAt   DateTime @default(now())

  // O id vem do celular (Date.now()), então só é único por usuário (phone).
  @@unique([phone, messageId])
  @@schema("assistent")
}

model user {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  // Meta de gastos por mês (vale para todos os meses até ser mudada); null = sem meta.
  monthlyGoal Decimal? @db.Decimal(12, 2)

  @@schema("assistent")
}
